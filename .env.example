# Template only. On the existing REG.ru server use /etc/imkonex-wheels/portal.env.
# Preserve its current values; this file is not a replacement for production settings.
# Never upload .env to GitHub. No default manager password is provided.
MANAGER_LOGIN=manager
MANAGER_PASSWORD=
FOURTOCHKI_LOGIN=
FOURTOCHKI_PASSWORD=
SUPPLIER_ORDERS_ENABLED=false
MANAGER_DB_PATH=/var/data/manager.sqlite3
# Legacy Render deployments may use RENDER_EXTERNAL_URL; REG.ru needs PUBLIC_ORIGIN.
# For a custom domain set the exact HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=
# Docker Compose public HTTPS configuration:
APP_DOMAIN=localhost
# Only for testing via http://localhost:8080 on your own computer:
# PUBLIC_ORIGIN=http://localhost:8080
# LOCAL_DEV=true

# Customer phone login (disabled while the secret/provider is not configured).
# Generate a unique random secret of at least 32 characters on the server.
# Rotating this secret invalidates existing customer sessions and SMS codes.
# See docs/CUSTOMER_SMS_AUTH.md before enabling paid SMS sending.
CUSTOMER_AUTH_SECRET=
# Choose smsru OR custom; leave blank until the provider is configured.
SMS_PROVIDER=
# SMS.ru credentials. SMS_RU_SENDER is optional and must be approved by SMS.ru.
SMS_RU_API_ID=
SMS_RU_SENDER=
# Alternative: our custom HTTPS bridge contract, not a vendor's generic API URL.
CUSTOMER_SMS_BRIDGE_URL=
CUSTOMER_SMS_BRIDGE_TOKEN=

# Company-specific procurement previews. No default company or ID is inferred.
# CUSTOMER_ID must be the real buyer ID returned by the selected account's API.
# A contract number or website address number is NOT a customer ID.
# These settings do not switch the global account used by the catalog/legacy orders.
# New procurement previews cannot submit supplier orders in this release.
FOURTOCHKI_ALITES_LOGIN=
FOURTOCHKI_ALITES_PASSWORD=
FOURTOCHKI_ALITES_CUSTOMER_ID=
FOURTOCHKI_INVEKS_LOGIN=
FOURTOCHKI_INVEKS_PASSWORD=
FOURTOCHKI_INVEKS_CUSTOMER_ID=

# Experimental SOAP signal receiver. Keep disabled until the supplier confirms
# the published WSDL/HTTP Basic contract and the exact HTTPS PUBLIC_ORIGIN.
# Each password must be a separate random secret of at least 24 characters.
# Signals are stored for manager review; automatic order processing is not enabled.
SUPPLIER_NOTIFICATIONS_ENABLED=false
FOURTOCHKI_ALITES_NOTIFY_USER=
FOURTOCHKI_ALITES_NOTIFY_PASSWORD=
FOURTOCHKI_INVEKS_NOTIFY_USER=
FOURTOCHKI_INVEKS_NOTIFY_PASSWORD=
