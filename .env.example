# Copy to .env only on your local machine / VPS. Never commit .env.
APP_DOMAIN=localhost
POSTGRES_PASSWORD=replace_with_a_random_hex_password
DATABASE_URL=postgresql://imkonex:replace_with_a_random_hex_password@db:5432/imkonex
DATA_MODE=demo
SERVE_FRONTEND=true
ALLOWED_ORIGINS=http://localhost:8080
# Leave empty to keep the private admin API disabled. Use at least 32 random characters.
ADMIN_API_TOKEN=
FOURTOCHKI_LOGIN=
FOURTOCHKI_PASSWORD=
NORMALIZED_FEED_PATH=/feeds/catalog.json
SYNC_INTERVAL_SECONDS=900
# Public static build setting. This is an API URL, NEVER a password or token.
PUBLIC_API_BASE=
